CapsLock & Left::
    Send, {Home}  ; Sends the End key action
    return       ; Prevents the Caps Lock function

CapsLock & Right::
    Send, {End}  ; Sends the End key action
    return       ; Prevents the Caps Lock function

CapsLock::
    Send, {End}  ; Sends the End key action
    return       ; Prevents the Caps Lock function

